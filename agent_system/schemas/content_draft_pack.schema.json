{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Draft Pack",
  "type": "object",
  "required": ["candidate_id", "telegram_draft", "source_usage_note", "gemstone_usage"],
  "properties": {
    "candidate_id": {"type": "string"},
    "title": {"type": "string"},
    "telegram_draft": {"type": "string"},
    "blog_outline": {"type": "array", "items": {"type": "string"}},
    "short_video_script": {"type": "string"},
    "source_usage_note": {"type": "string"},
    "gemstone_usage": {"type": "string", "enum": ["none", "subtle", "explicit_context", "requires_consultation_note"]},
    "cta": {"type": "string"},
    "risk_notes": {"type": "array", "items": {"type": "string"}}
  }
}

