{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Pack",
  "type": "object",
  "required": ["candidate_id", "visual_concept", "image_generation_prompt", "negative_prompt", "dimensions"],
  "properties": {
    "candidate_id": {"type": "string"},
    "visual_concept": {"type": "string"},
    "canva_brief": {"type": "string"},
    "image_generation_prompt": {"type": "string"},
    "negative_prompt": {"type": "string"},
    "dimensions": {"type": "array", "items": {"type": "string"}},
    "should_show_gemstone_or_jewelry": {"type": "string", "enum": ["yes", "no", "optional"]},
    "text_overlay": {"type": "string"},
    "style_notes": {"type": "array", "items": {"type": "string"}}
  }
}

